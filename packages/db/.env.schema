# @currentEnv=$VARLOCK_ENV
# @defaultSensitive=false @defaultRequired=false
# @generateTypes(lang=ts, path=env.d.ts)
# ---

# libsql URL of the database drizzle-kit migrates.
# Preview jobs set this to the pull request database or the anonymized snapshot.
# @required=forEnv(preview, production)
DATABASE_URL=remap($VARLOCK_ENV, /development|test/, "file:local.db", undefined)

# @sensitive
# @required=forEnv(preview, production)
TURSO_AUTH_TOKEN=

TURSO_ORGANIZATION_SLUG=

TURSO_PREVIEW_GROUP_NAME=

# @sensitive
TURSO_PREVIEW_GROUP_TOKEN=

TURSO_PROD_DATABASE_URL=

# @sensitive
TURSO_PROD_READ_TOKEN=

# @sensitive
ANON_HASH_KEY=

PR_NUMBER=

SNAPSHOT_DATABASE_URL=

SNAPSHOT_DATABASE_NAME=
