# @generateTypes(lang=ts, path=env.d.ts)
# ---

# Cloudflare account that owns the Email Service sender domain.
# @required=forEnv(preview, production)
CLOUDFLARE_ACCOUNT_ID=

# API token with the Account > Email Sending > Edit permission.
# @required=forEnv(preview, production) @sensitive
CLOUDFLARE_EMAIL_API_TOKEN=

# Verified sender address for transactional notifications.
# @required=forEnv(preview, production) @type=string(email)
NOTIFICATION_FROM_EMAIL=

# Display name shown as the sender of transactional notifications.
# @required=forEnv(preview, production)
NOTIFICATION_FROM_NAME=Blockbase
