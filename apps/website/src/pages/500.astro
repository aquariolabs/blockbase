---
import Layout from "../layouts/Layout.astro";

Astro.response.status = 500;
---

<Layout
  title="Erro interno"
  description="Algo inesperado aconteceu ao carregar esta pagina."
>
  <main class="container flex min-h-svh items-center py-16">
    <section class="max-w-2xl">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-muted-foreground">
        Erro 500
      </p>
      <h1 class="mt-5 text-4xl font-semibold leading-tight sm:text-5xl">
        Algo quebrou por aqui.
      </h1>
      <p class="mt-5 max-w-xl text-base leading-7 text-muted-foreground sm:text-lg">
        Nao conseguimos concluir esta requisicao agora. Tente recarregar a pagina ou volte para o
        inicio enquanto investigamos.
      </p>
      <a
        class="mt-8 inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
        href="/"
      >
        Voltar para o inicio
      </a>
    </section>
  </main>
</Layout>
